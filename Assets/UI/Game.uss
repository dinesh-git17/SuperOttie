/* Reference resolution is 1920x1080 (PanelSettings scales by height). */

.root {
    flex-grow: 1;
    color: rgb(255, 255, 255);
}

.fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.screen-dark {
    background-color: rgb(24, 16, 12);
}

.screen-dim {
    background-color: rgba(24, 16, 12, 0.72);
}

Label {
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(59, 36, 20);
    text-shadow: 0 5px 0 rgba(59, 36, 20, 0.85);
    padding: 0;
    margin: 0;
}

/* ---------- HUD ---------- */

.hud {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 14px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-group {
    flex-direction: row;
    align-items: center;
}

.hud-item {
    flex-direction: row;
    align-items: center;
    margin-right: 36px;
}

.hud-icon {
    width: 72px;
    height: 72px;
    margin-right: 8px;
    background-size: contain;
}

.hud-text {
    font-size: 60px;
}

.hud-small {
    font-size: 44px;
    margin-right: 32px;
    color: rgb(255, 236, 170);
}

.hud-score {
    font-size: 64px;
    letter-spacing: 4px;
}

.pause-button {
    width: 110px;
    height: 110px;
    margin-left: 32px;
    background-size: contain;
}

/* ---------- Touch controls ---------- */

.controls {
    position: absolute;
    left: 36px;
    right: 36px;
    bottom: 24px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.stick {
    width: 300px;
    height: 300px;
    margin-left: 20px;
    align-items: center;
    justify-content: center;
    background-size: contain;
    opacity: 0.6;
}

.stick-knob {
    width: 130px;
    height: 130px;
    background-size: contain;
}

.stick-held {
    opacity: 1;
}

.ctrl {
    width: 195px;
    height: 195px;
    margin-right: 30px;
    background-size: contain;
    opacity: 0.6;
}

.ctrl-jump {
    width: 225px;
    height: 225px;
    margin-right: 10px;
}

.ctrl-pressed {
    opacity: 1;
    scale: 0.92 0.92;
}

/* ---------- Banner ---------- */

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 220px;
    align-items: center;
    display: none;
}

.banner-text {
    font-size: 110px;
    color: rgb(255, 214, 64);
    -unity-text-outline-width: 5px;
}

/* ---------- Main menu ---------- */

.title-art {
    background-size: cover;
}

/* Warm shade behind the left column so the buttons read against the bright art (texture set in code). */
.title-scrim {
    background-size: 100% 100%;
}

/* The key art keeps Ottie on the right half; the logo and buttons sit in a column on the left. */
.title-column {
    position: absolute;
    left: 4%;
    top: 0;
    bottom: 0;
    width: 44%;
    align-items: center;
    justify-content: center;
}

.title-logo {
    width: 640px;
    height: 323px;
    margin-bottom: 40px;
    background-size: contain;
}

.menu-btn {
    width: 600px;
    height: 140px;
    margin-bottom: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 40px;
    border-width: 6px;
    border-bottom-width: 16px;
    border-color: rgb(59, 36, 20);
    transition-property: scale;
    transition-duration: 0.12s;
}

.menu-btn-text {
    font-size: 76px;
}

.menu-btn-primary {
    background-color: rgb(255, 190, 46);
    border-bottom-color: rgb(186, 98, 20);
}

.menu-btn-secondary {
    background-color: rgb(255, 243, 214);
    border-bottom-color: rgb(196, 156, 104);
}

.menu-btn-secondary .menu-btn-text {
    color: rgb(92, 56, 30);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.menu-badge {
    position: absolute;
    right: 26px;
    padding: 4px 18px;
    border-radius: 24px;
    background-color: rgb(92, 56, 30);
}

.menu-badge-text {
    font-size: 40px;
    color: rgb(255, 214, 64);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* Keyboard / gamepad highlight (touch players never see it). */
.menu-focused {
    scale: 1.06 1.06;
    border-left-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
}

.title-best {
    margin-top: 6px;
    font-size: 46px;
    color: rgb(255, 236, 170);
}

.icon-btn {
    width: 124px;
    height: 124px;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
}

.icon-btn-glyph {
    width: 100%;
    height: 100%;
    background-size: contain;
}

/* The back arrow sits on a cream disc to match the sound button's art. */
.icon-btn-disc {
    border-radius: 62px;
    border-width: 6px;
    border-color: rgb(59, 36, 20);
    background-color: rgb(255, 243, 214);
}

.icon-btn-disc .icon-btn-glyph {
    width: 70%;
    height: 70%;
}

.icon-btn.menu-focused {
    border-color: rgb(255, 255, 255);
}

/* Bottom-right, on the grass, so it can't be mistaken for one of the coins in the key art. */
.menu-sound {
    position: absolute;
    bottom: 30px;
    right: 40px;
}

/* ---------- Course select ---------- */

.courses-dim {
    background-color: rgba(24, 16, 12, 0.7);
}

.courses-layout {
    align-items: center;
    justify-content: center;
}

.courses-header {
    width: 1560px;
    height: 136px;
    margin-bottom: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.courses-title {
    position: absolute;
    left: 0;
    right: 0;
    font-size: 88px;
    color: rgb(255, 214, 64);
    -unity-text-align: middle-center;
}

.courses-tally {
    flex-direction: row;
    align-items: center;
    padding: 8px 30px 8px 16px;
    border-radius: 50px;
    background-color: rgba(59, 36, 20, 0.8);
}

.courses-tally-icon {
    width: 72px;
    height: 72px;
    margin-right: 10px;
    background-size: contain;
}

.courses-tally-text {
    font-size: 54px;
}

.courses-grid {
    width: 1560px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.course-card {
    width: 480px;
    margin: 14px 20px;
    border-radius: 36px;
    border-width: 7px;
    border-color: rgb(255, 243, 214);
    background-color: rgb(255, 243, 214);
    overflow: hidden;
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.course-thumb {
    height: 236px;
    align-items: center;
    justify-content: center;
    background-size: cover;
    border-top-left-radius: 29px;
    border-top-right-radius: 29px;
}

.course-footer {
    height: 92px;
    padding: 0 22px;
    flex-direction: row;
    align-items: center;
}

.course-num {
    margin-right: 16px;
    padding: 2px 16px;
    border-radius: 18px;
    font-size: 40px;
    color: rgb(255, 214, 64);
    background-color: rgb(92, 56, 30);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.course-name {
    font-size: 46px;
    color: rgb(92, 56, 30);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.course-star {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 86px;
    height: 86px;
    background-size: contain;
    display: none;
}

.course-lock {
    width: 124px;
    height: 124px;
    background-size: contain;
    display: none;
}

.course-cleared .course-star {
    display: flex;
}

/* The suggested course (the furthest one open) gets a gold frame. */
.course-next {
    border-color: rgb(255, 196, 48);
    background-color: rgb(255, 196, 48);
}

.course-locked {
    border-color: rgb(186, 176, 162);
    background-color: rgb(186, 176, 162);
}

.course-locked .course-thumb {
    -unity-background-image-tint-color: rgb(92, 86, 104);
}

.course-locked .course-lock {
    display: flex;
}

.course-locked .course-num {
    color: rgb(232, 224, 212);
    background-color: rgb(128, 118, 106);
}

.course-locked .course-name {
    color: rgb(112, 102, 92);
}

.course-card.menu-focused {
    scale: 1.05 1.05;
    border-color: rgb(255, 255, 255);
}

.courses-hint {
    margin-top: 16px;
    font-size: 42px;
    color: rgb(255, 236, 170);
}

/* ---------- Text styles ---------- */

.huge-text {
    font-size: 140px;
    color: rgb(255, 214, 64);
    margin-bottom: 20px;
}

.big-text {
    font-size: 96px;
    margin-bottom: 10px;
}

.mid-text {
    font-size: 60px;
    margin-bottom: 14px;
    color: rgb(255, 236, 170);
}

.prompt-text {
    font-size: 56px;
    margin-top: 40px;
}

.intro-lives {
    flex-direction: row;
    align-items: center;
    margin-top: 40px;
}

.intro-icon {
    width: 120px;
    height: 120px;
    margin-right: 20px;
    background-size: contain;
}

/* ---------- Pause menu ---------- */

.panel {
    padding: 50px 110px;
    border-radius: 40px;
    background-color: rgba(60, 38, 22, 0.94);
    border-width: 6px;
    border-color: rgb(255, 214, 64);
    align-items: center;
}

.menu-button {
    font-size: 64px;
    margin-top: 22px;
    padding: 12px 60px;
    min-width: 560px;
    -unity-text-align: middle-center;
    border-radius: 26px;
    background-color: rgb(236, 138, 44);
    border-bottom-width: 8px;
    border-color: rgb(150, 76, 22);
}

/* ---------- Victory ---------- */

.victory-ottie {
    width: 280px;
    height: 280px;
    background-size: contain;
}

/* ---------- Fade ---------- */

.fade {
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

/* ---------- Score popups ---------- */

.popup {
    position: absolute;
    font-size: 46px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 4px;
}
