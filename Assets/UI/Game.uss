/* Reference resolution is 1920x1080 (PanelSettings scales by height). */

.root {
    flex-grow: 1;
    color: rgb(255, 255, 255);
}

.fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.screen-dark {
    background-color: rgb(24, 16, 12);
}

.screen-dim {
    background-color: rgba(24, 16, 12, 0.72);
}

Label {
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(59, 36, 20);
    text-shadow: 0 5px 0 rgba(59, 36, 20, 0.85);
    padding: 0;
    margin: 0;
}

/* ---------- HUD ---------- */

.hud {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 14px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-group {
    flex-direction: row;
    align-items: center;
}

.hud-item {
    flex-direction: row;
    align-items: center;
    margin-right: 36px;
}

.hud-icon {
    width: 72px;
    height: 72px;
    margin-right: 8px;
    background-size: contain;
}

.hud-text {
    font-size: 60px;
}

.hud-small {
    font-size: 44px;
    margin-right: 32px;
    color: rgb(255, 236, 170);
}

.hud-score {
    font-size: 64px;
    letter-spacing: 4px;
}

.pause-button {
    width: 110px;
    height: 110px;
    margin-left: 32px;
    background-size: contain;
}

/* ---------- Touch controls ---------- */

.controls {
    position: absolute;
    left: 36px;
    right: 36px;
    bottom: 24px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.dpad {
    flex-direction: row;
    align-items: flex-end;
}

.ctrl {
    width: 195px;
    height: 195px;
    margin-right: 30px;
    background-size: contain;
    opacity: 0.6;
}

.ctrl-jump {
    width: 225px;
    height: 225px;
    margin-right: 10px;
}

.ctrl-pressed {
    opacity: 1;
    scale: 0.92 0.92;
}

/* ---------- Banner ---------- */

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 220px;
    align-items: center;
    display: none;
}

.banner-text {
    font-size: 110px;
    color: rgb(255, 214, 64);
    -unity-text-outline-width: 5px;
}

/* ---------- Title ---------- */

.title-art {
    background-size: cover;
}

.title-logo {
    position: absolute;
    top: 40px;
    left: 9%;
    width: 42%;
    height: 48%;
    background-size: contain;
}

/* The key art keeps Ottie on the right half; the text column sits on the left. */
.title-prompt {
    position: absolute;
    left: 9%;
    width: 42%;
    bottom: 150px;
    font-size: 84px;
    -unity-text-align: middle-center;
    color: rgb(255, 240, 180);
}

.title-best {
    position: absolute;
    left: 9%;
    width: 42%;
    bottom: 80px;
    font-size: 44px;
    -unity-text-align: middle-center;
}

/* ---------- Text styles ---------- */

.huge-text {
    font-size: 140px;
    color: rgb(255, 214, 64);
    margin-bottom: 20px;
}

.big-text {
    font-size: 96px;
    margin-bottom: 10px;
}

.mid-text {
    font-size: 60px;
    margin-bottom: 14px;
    color: rgb(255, 236, 170);
}

.prompt-text {
    font-size: 56px;
    margin-top: 40px;
}

.intro-lives {
    flex-direction: row;
    align-items: center;
    margin-top: 40px;
}

.intro-icon {
    width: 120px;
    height: 120px;
    margin-right: 20px;
    background-size: contain;
}

/* ---------- Pause menu ---------- */

.panel {
    padding: 50px 110px;
    border-radius: 40px;
    background-color: rgba(60, 38, 22, 0.94);
    border-width: 6px;
    border-color: rgb(255, 214, 64);
    align-items: center;
}

.menu-button {
    font-size: 64px;
    margin-top: 22px;
    padding: 12px 60px;
    min-width: 560px;
    -unity-text-align: middle-center;
    border-radius: 26px;
    background-color: rgb(236, 138, 44);
    border-bottom-width: 8px;
    border-color: rgb(150, 76, 22);
}

/* ---------- Victory ---------- */

.victory-ottie {
    width: 280px;
    height: 280px;
    background-size: contain;
}

/* ---------- Fade ---------- */

.fade {
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

/* ---------- Score popups ---------- */

.popup {
    position: absolute;
    font-size: 46px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 4px;
}
