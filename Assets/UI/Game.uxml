<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Game.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">

        <!-- Gameplay layer: HUD + touch controls, padded to the device safe area. -->
        <ui:VisualElement name="safe" class="fill safe-area" picking-mode="Ignore">
            <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
                <ui:VisualElement class="hud-group" picking-mode="Ignore">
                    <ui:VisualElement class="hud-item" picking-mode="Ignore">
                        <ui:VisualElement name="hud-life-icon" class="hud-icon" picking-mode="Ignore" />
                        <ui:Label name="hud-lives" text="x3" class="hud-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-item" picking-mode="Ignore">
                        <ui:VisualElement name="hud-coin-icon" class="hud-icon" picking-mode="Ignore" />
                        <ui:Label name="hud-coins" text="x00" class="hud-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="hud-score" text="000000" class="hud-text hud-score" picking-mode="Ignore" />
                <ui:VisualElement class="hud-group" picking-mode="Ignore">
                    <ui:Label name="hud-world" text="1-1" class="hud-text hud-small" picking-mode="Ignore" />
                    <ui:Label name="hud-time" text="300" class="hud-text" picking-mode="Ignore" />
                    <ui:VisualElement name="btn-pause" class="pause-button" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="controls" class="controls" picking-mode="Ignore">
                <ui:VisualElement name="stick" class="stick" picking-mode="Ignore">
                    <ui:VisualElement name="stick-knob" class="stick-knob" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="btn-jump" class="ctrl ctrl-jump" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="banner" class="banner" picking-mode="Ignore">
                <ui:Label name="banner-text" text="COURSE CLEAR!" class="banner-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main menu: key art on the right, logo and buttons in a column on the left. -->
        <ui:VisualElement name="title" class="screen" picking-mode="Ignore">
            <ui:VisualElement name="title-art" class="fill title-art" picking-mode="Ignore" />
            <ui:VisualElement name="title-scrim" class="fill title-scrim" picking-mode="Ignore" />
            <ui:VisualElement name="title-safe" class="fill safe-area" picking-mode="Ignore">
                <ui:VisualElement class="title-column" picking-mode="Ignore">
                    <ui:VisualElement name="title-logo" class="title-logo" picking-mode="Ignore" />
                    <ui:VisualElement name="menu-new" class="menu-btn menu-btn-primary" picking-mode="Ignore">
                        <ui:Label text="New Game" class="menu-btn-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="menu-courses" class="menu-btn menu-btn-secondary" picking-mode="Ignore">
                        <ui:Label text="Courses" class="menu-btn-text" picking-mode="Ignore" />
                        <ui:VisualElement class="menu-badge" picking-mode="Ignore">
                            <ui:Label name="menu-courses-count" text="1/6" class="menu-badge-text" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="title-best" text="Best 000000" class="title-best" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="menu-sound" class="icon-btn menu-sound" picking-mode="Ignore">
                    <ui:VisualElement name="menu-sound-icon" class="icon-btn-glyph" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Course select: one card per course, built in code from the level list. -->
        <ui:VisualElement name="courses" class="screen" picking-mode="Ignore">
            <ui:VisualElement name="courses-art" class="fill title-art" picking-mode="Ignore" />
            <ui:VisualElement class="fill courses-dim" picking-mode="Ignore" />
            <ui:VisualElement name="courses-safe" class="fill safe-area courses-layout" picking-mode="Ignore">
                <ui:VisualElement class="courses-header" picking-mode="Ignore">
                    <ui:VisualElement name="courses-back" class="icon-btn icon-btn-disc" picking-mode="Ignore">
                        <ui:VisualElement name="courses-back-icon" class="icon-btn-glyph" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label text="Choose a Course" class="courses-title" picking-mode="Ignore" />
                    <ui:VisualElement class="courses-tally" picking-mode="Ignore">
                        <ui:VisualElement name="courses-tally-icon" class="courses-tally-icon" picking-mode="Ignore" />
                        <ui:Label name="courses-tally" text="0/6" class="courses-tally-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="courses-grid" class="courses-grid" picking-mode="Ignore" />
                <ui:Label name="courses-hint" text="Clear a course to open the next one" class="courses-hint" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="intro" class="screen screen-dark" picking-mode="Ignore">
            <ui:Label name="intro-world" text="WORLD 1-1" class="big-text" picking-mode="Ignore" />
            <ui:Label name="intro-name" text="Sunny Meadow" class="mid-text" picking-mode="Ignore" />
            <ui:VisualElement class="intro-lives" picking-mode="Ignore">
                <ui:VisualElement name="intro-life-icon" class="intro-icon" picking-mode="Ignore" />
                <ui:Label name="intro-lives" text="x 3" class="big-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="pause" class="screen screen-dim" picking-mode="Ignore">
            <ui:VisualElement class="panel" picking-mode="Ignore">
                <ui:Label text="Paused" class="big-text" picking-mode="Ignore" />
                <ui:Label name="pause-resume" text="Resume" class="menu-button" picking-mode="Ignore" />
                <ui:Label name="pause-restart" text="Restart level" class="menu-button" picking-mode="Ignore" />
                <ui:Label name="pause-sound" text="Sound: On" class="menu-button" picking-mode="Ignore" />
                <ui:Label name="pause-quit" text="Main menu" class="menu-button" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gameover" class="screen screen-dark" picking-mode="Ignore">
            <ui:Label text="GAME OVER" class="huge-text" picking-mode="Ignore" />
            <ui:Label name="gameover-score" text="Score 000000" class="mid-text" picking-mode="Ignore" />
            <ui:Label text="Tap to continue" class="prompt-text blink" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="victory" class="screen screen-dim" picking-mode="Ignore">
            <ui:VisualElement name="victory-ottie" class="victory-ottie" picking-mode="Ignore" />
            <ui:Label text="You did it!" class="huge-text" picking-mode="Ignore" />
            <ui:Label name="victory-score" text="Score 000000" class="mid-text" picking-mode="Ignore" />
            <ui:Label name="victory-best" text="Best 000000" class="mid-text" picking-mode="Ignore" />
            <ui:Label text="Tap to continue" class="prompt-text blink" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fill fade" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
